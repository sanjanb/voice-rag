# Speech-to-Text
STT_PRIMARY=hosted
STT_FALLBACK=local
STT_TIMEOUT_MS=120
STT_MAX_RETRIES=1

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=voice_rag

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=100

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TIMEOUT_MS=40

# Retrieval
DENSE_TOP_N=20
SPARSE_TOP_N=20
FUSED_TOP_N=20
FINAL_TOP_K=5

# Guardrails
MIN_RETRIEVAL_CONFIDENCE=null
MIN_CANDIDATES=1
MAX_UNSUPPORTED_CLAIMS=0

# Timeouts
STT_BUDGET_MS=120
QUERY_BUDGET_MS=10
RETRIEVAL_BUDGET_MS=40
RERANK_BUDGET_MS=40
GENERATION_BUDGET_MS=100
TOTAL_BUDGET_MS=200

# Retry
MAX_ATTEMPTS=2
BACKOFF_MS=20

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
